# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/heatsafe
DATABASE_USERNAME=heatsafe
DATABASE_PASSWORD=heatsafe

# FortyGuard API Configuration
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
